# Database (Local Postgres in Docker)
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=agileflow_dev
DB_URL=jdbc:postgresql://localhost:5432/agileflow_dev

# JWT Security
JWT_SECRET=super-secret-jwt-key-for-local-dev-must-be-at-least-256-bits-long
JWT_EXPIRATION_MS=86400000
JWT_ISSUER_URI=http://localhost:8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_URL=http://localhost:9000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Mailhog
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
